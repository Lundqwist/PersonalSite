@*
    Views/About/Index.cshtml — the public About page.
    The text is written on /Admin/About in Markdown and converted to HTML here.
*@
@using PersonalSite.Services
@* The model may be null ("?") when no About text has been saved yet *@
@model PageContent?
@* @inject asks dependency injection for a service, like a constructor
   parameter in a controller. Here: the Markdown converter. *@
@inject MarkdownRenderer Markdown
@{
    var title = Model?.Title;
    var body = Model?.Body;
    ViewData["Title"] = "About";
}

<div class="page-header page-header--with-actions">
    <div>
        <p class="page-eyebrow">About</p>
        @* Use the saved heading, or a default when none is written *@
        <h1>@(string.IsNullOrWhiteSpace(title) ? "About me" : title)</h1>
        @* Link to the CV page, below the headline *@
        <a class="btn btn-primary page-header-btn" asp-controller="CV" asp-action="Index">View my CV →</a>
    </div>
    @* Framed image to the right of the headline (styles: .framed-image in site.css) *@
    <figure class="framed-image framed-image--landscape page-header-image">
        <img src="~/images/about.jpg" asp-append-version="true" width="760" height="633"
             alt="Bjarne with a cup of coffee by a tent on the rocks, with the sun setting over the sea" />
    </figure>
</div>

@if (string.IsNullOrWhiteSpace(body))
{
    <div class="empty-page empty-page--compact">
        <div class="empty-inner">
            <span class="empty-icon" aria-hidden="true">◉</span>
            <p>Coming soon.</p>
        </div>
    </div>
}
else
{
    <article class="post-article post-article--page">
        @* Markdown.Render returns safe, already-cleaned HTML (see MarkdownRenderer.cs) *@
        <div class="post-body prose page-card">@Markdown.Render(body)</div>
    </article>
}
