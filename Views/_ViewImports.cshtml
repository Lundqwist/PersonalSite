@*
    _ViewImports.cshtml — settings shared by every view in this folder and below.
    @using       makes these namespaces available in all views (like "using" in C#)
    @addTagHelper enables the tag helpers (asp-controller, asp-for, <partial>, ...)
*@
@using PersonalSite
@using PersonalSite.Models
@using PersonalSite.Data
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
