@*
    Views/Shared/PostDetails.cshtml — one story, project or portfolio item.
    Shared by the three controllers in Controllers/PostCategoryController.cs.
*@
@using System.Globalization
@using PersonalSite.Services
@model Post
@* The Markdown converter, provided by dependency injection *@
@inject MarkdownRenderer Markdown
@{
    // Shared by Stories, Projects and Portfolio
    var category = Model.Category;
    var isPortfolio = category == PostCategory.Portfolio;
    var backText = category switch
    {
        PostCategory.Story => "All stories",
        PostCategory.Project => "All projects",
        _ => "Whole portfolio",
    };
    ViewData["Title"] = Model.Title;
}

<article class="post-article">
    <div class="post-article-top">
        @* asp-action="Index" without a controller = this controller's list page *@
        <a class="post-back" asp-action="Index">← @backText</a>
    </div>

    @* Title card: date, title, summary (and "Visit site" for portfolio
       items), in the same card style as the text below (.page-card in site.css) *@
    <header class="page-card post-header-card">
        <div class="post-card-meta">
            <time datetime="@Model.PublishedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                @Model.PublishedDate.ToString("d MMMM yyyy", CultureInfo.CurrentCulture)
            </time>
        </div>
        <h1 lang="@Model.Language">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Summary))
        {
            <p class="post-lead" lang="@Model.Language">@Model.Summary</p>
        }
        @* Portfolio items get a prominent "Visit site" button near the top.
           target="_blank" opens a new tab; rel="noopener noreferrer" stops the
           other site from controlling this tab (a security precaution). *@
        @if (isPortfolio && !string.IsNullOrWhiteSpace(Model.Url))
        {
            <p class="post-visit">
                <a class="btn btn-primary" href="@Model.Url" target="_blank" rel="noopener noreferrer">
                    Visit site ↗
                </a>
                <span class="post-visit-host">@Model.UrlHost</span>
            </p>
        }
    </header>

    @* The cover image, full size *@
    @if (Model.CoverImageId.HasValue)
    {
        <figure class="post-cover">
            <img src="/media/@Model.CoverImageId" alt="" decoding="async" />
        </figure>
    }

    @* The text: Markdown converted to safe HTML (see Services/MarkdownRenderer.cs),
       shown in a card like the About page (.page-card in site.css) *@
    @if (!string.IsNullOrWhiteSpace(Model.Body))
    {
        <div class="post-body prose page-card" lang="@Model.Language">@Markdown.Render(Model.Body)</div>
    }

    @* The link again at the bottom *@
    @if (!string.IsNullOrWhiteSpace(Model.Url))
    {
        <p class="post-link">
            <a href="@Model.Url" target="_blank" rel="noopener noreferrer">
                @(isPortfolio ? "Visit site" : "Open link") ↗
            </a>
        </p>
    }
</article>
