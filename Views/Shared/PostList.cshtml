@*
    Views/Shared/PostList.cshtml — the list page for Stories, Projects and Portfolio.

    Shared by the three controllers in Controllers/PostCategoryController.cs.
    They pass the posts as the Model and the category in ViewData["Category"];
    the category decides the heading, the image and some details below.
*@
@using System.Globalization
@model List<Post>
@{
    // "as PostCategory?" tries to read the value as a category (null if not);
    // "?? PostCategory.Story" falls back to Story.
    var category = ViewData["Category"] as PostCategory? ?? PostCategory.Story;

    // switch expressions pick the texts for this category, in the current language
    var heading = category switch
    {
        PostCategory.Story => Lang.T("Berättelser", "Stories"),
        PostCategory.Project => Lang.T("Projekt", "Projects"),
        _ => Lang.T("Portfolio", "Portfolio"),
    };
    var eyebrow = category switch
    {
        PostCategory.Story => Lang.T("Tankar & texter", "Thoughts & writing"),
        PostCategory.Project => Lang.T("Sidoprojekt & experiment", "Side projects & experiments"),
        _ => Lang.T("Webbplatser & uppdrag", "Websites & work"),
    };
    var icon = category switch { PostCategory.Story => "◇", PostCategory.Project => "◆", _ => "▣" };
    ViewData["Title"] = heading;
}

<div class="page-header page-header--with-actions">
    <div>
        <p class="page-eyebrow">@eyebrow</p>
        <h1>@heading</h1>
    </div>
    @* Each page shows an image next to the headline; posts are tagged SE/EN
       individually, so there is no language switch here *@
    @switch (category)
    {
        case PostCategory.Story:
            <figure class="framed-image framed-image--square page-header-image">
                <img src="~/images/stories.jpg" asp-append-version="true" width="640" height="640"
                     alt="@Lang.T("Illustration av Bjarne som skriver med fjäderpenna vid ett levande ljus", "Illustration of Bjarne writing with a quill by candlelight")" />
            </figure>
            break;
        case PostCategory.Project:
            <figure class="framed-image framed-image--square page-header-image">
                <img src="~/images/projects.jpg" asp-append-version="true" width="700" height="640"
                     alt="@Lang.T("Illustration av Bjarne som bygger en kugghjulsmekanism i en verkstad", "Illustration of Bjarne building a clockwork mechanism in a workshop")" />
            </figure>
            break;
        default:
            <figure class="framed-image framed-image--wide page-header-image">
                <img src="~/images/portfolio.jpg" asp-append-version="true" width="840" height="560"
                     alt="@Lang.T("Bjarne presenterar resultat vid en whiteboard", "Bjarne presenting results at a whiteboard")" />
            </figure>
            break;
    }
</div>

@if (Model.Count == 0)
{
    @* Nothing published yet *@
    <div class="empty-page empty-page--compact">
        <div class="empty-inner">
            <span class="empty-icon" aria-hidden="true">@icon</span>
            <p>@Lang.T("Inget publicerat ännu.", "Nothing published yet.")</p>
        </div>
    </div>
}
else
{
    <section class="post-list">
        @foreach (var post in Model)
        {
            // The cover image, or the first image in the text (see Post.cs)
            var thumbId = post.GetThumbnailImageId();

            @* The whole card is one link. asp-route-id adds the post's number:
               asp-action="Details" + id 7  ->  /Stories/Details/7 *@
            <a class="post-card @(thumbId.HasValue ? "post-card--image" : "")" asp-action="Details" asp-route-id="@post.Id">
                @if (thumbId.HasValue)
                {
                    @* alt="" = decorative (the title is right below it).
                       loading="lazy" = only load when scrolled into view. *@
                    <div class="post-card-thumb">
                        <img src="/media/@thumbId/thumb" alt="" loading="lazy" decoding="async" />
                    </div>
                }
                <div class="post-card-meta">
                    @* <time datetime="2026-10-12"> gives a machine-readable date;
                       the visible text uses the visitor's language. *@
                    <time datetime="@post.PublishedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                        @post.PublishedDate.ToString("d MMMM yyyy", CultureInfo.CurrentCulture)
                    </time>
                    @* The SE/EN tag (Views/Shared/_LangTag.cshtml), with this post as its model *@
                    <partial name="_LangTag" model="post" />
                </div>
                @* lang tells screen readers which language this title is in *@
                <h2 lang="@post.Language">@post.Title</h2>
                @if (!string.IsNullOrWhiteSpace(post.Summary))
                {
                    <p lang="@post.Language">@post.Summary</p>
                }
                @if (category == PostCategory.Portfolio && post.UrlHost != null)
                {
                    @* The whole card is a link, so the site address is shown as text;
                       the "Visit site" button is on the item's page *@
                    <span class="post-card-site">↗ @post.UrlHost</span>
                }
                <span class="post-card-more">@Lang.T("Läs mer", "Read more") →</span>
            </a>
        }
    </section>
}
