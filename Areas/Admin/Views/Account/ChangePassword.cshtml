@*
    Areas/Admin/Views/Account/ChangePassword.cshtml — form for changing the admin password.
    Saved by AccountController.ChangePassword (POST). The rules (at least 12 characters,
    both new passwords equal) come from the attributes on ChangePasswordViewModel.
    autocomplete="new-password" lets password managers suggest a strong password.
*@
@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="admin-page">
    <partial name="_AdminHeader" model="@("Change password")" />

    <form method="post" asp-action="ChangePassword" class="admin-form admin-card admin-form--narrow">
        <div class="form-field">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="form-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span class="form-hint">At least 12 characters.</span>
            <span asp-validation-for="NewPassword" class="form-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="form-error"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Change password</button>
            <a class="btn btn-ghost" asp-controller="Dashboard" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
