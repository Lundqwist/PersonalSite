@*
    Areas/Admin/Views/About/Index.cshtml — the About page editor. Same toolbar,
    preview and image library as the post editor, without a cover image.
*@
@model PageContent
@{
    ViewData["Title"] = "Admin · About";
    var images = ViewData["Images"] as List<MediaListItem> ?? new();
}

<div class="admin-page">
    <partial name="_AdminHeader" model="@("About page")" />

    <form method="post" asp-action="Index" class="admin-form admin-card"
          data-editor
          data-upload-url="@Url.Action("Upload", "Media", new { area = "Admin" })"
          data-delete-url="@Url.Action("Delete", "Media", new { area = "Admin" })"
          data-preview-url="@Url.Action("Preview", "Posts", new { area = "Admin" })">
        <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>

        <div class="form-field">
            <label asp-for="Title">Heading</label>
            <input asp-for="Title" placeholder="About me" />
        </div>

        <partial name="_MarkdownField" model="@(("Body", "Text", Model.Body))" />
        <partial name="_FormattingHelp" />

        <partial name="_MediaLibrary" model="@((images, false))" />

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-ghost" asp-area="" asp-controller="About" asp-action="Index">View page</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/admin-editor.js" asp-append-version="true"></script>
}
